<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Diagonal indigo-violet gradient -->
    <path android:pathData="M 0,0 L 108,0 L 108,108 L 0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="108"
                android:endY="108"
                android:startX="0"
                android:startY="0"
                android:type="linear">
                <item
                    android:color="#6E7BFF"
                    android:offset="0.0" />
                <item
                    android:color="#5566F6"
                    android:offset="0.52" />
                <item
                    android:color="#343CB8"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Soft top-left radial glow -->
    <path android:pathData="M 0,0 L 108,0 L 108,108 L 0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="36"
                android:centerY="30"
                android:gradientRadius="62"
                android:type="radial">
                <item
                    android:color="#38FFFFFF"
                    android:offset="0.0" />
                <item
                    android:color="#00FFFFFF"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle concentric signal rings -->
    <path
        android:pathData="M 18,54 A 36,36 0 1,0 90,54 A 36,36 0 1,0 18,54 Z"
        android:strokeAlpha="0.11"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.2" />
    <path
        android:pathData="M 9,54 A 45,45 0 1,0 99,54 A 45,45 0 1,0 9,54 Z"
        android:strokeAlpha="0.06"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.2" />
</vector>
