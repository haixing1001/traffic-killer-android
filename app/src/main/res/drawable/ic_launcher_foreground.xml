    <path
        android:fillColor="#5EEAD4"
        android:pathData="M 51.0,38.5 L 57.0,38.5 A 1.5,1.5 0 0,1 57.0,41.5 L 51.0,41.5 A 1.5,1.5 0 0,1 51.0,38.5 Z" />

