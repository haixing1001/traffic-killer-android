                android:endY="52.00"
                android:startX="37.74"
                android:startY="70.26"
                android:type="linear">
                <item
                    android:color="#FFFFFF"
                    android:offset="0.0" />
                <item
                    android:color="#D8F3FF"
                    android:offset="0.62" />
                <item
                    android:color="#5EEAD4"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glowing arc tip dot -->
    <path
        android:fillAlpha="0.35"
        android:fillColor="#5EEAD4"
        android:pathData="M 72.71,52.00 A 4.2,4.2 0 1,0 81.11,52.00 A 4.2,4.2 0 1,0 72.71,52.00 Z" />
